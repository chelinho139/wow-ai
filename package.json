{
  "name": "wow-ai",
  "version": "0.5.0",
  "private": true,
  "description": "Chat with local coding agents (Claude Code, Codex, Grok Build, Antigravity, Hermes) from inside World of Warcraft: Forever, with no UI reloads. Pixel strip out, load-on-demand slots in.",
  "license": "MIT",
  "author": "chelinho139",
  "repository": {
    "type": "git",
    "url": "https://github.com/chelinho139/wow-ai"
  },
  "keywords": [
    "world-of-warcraft",
    "wow-addon",
    "claude-code",
    "claude",
    "codex",
    "grok",
    "coding-agent",
    "bridge"
  ],
  "engines": {
    "node": ">=22.2"
  },
  "bin": {
    "wow-ai": "bridge/supervisor.js"
  },
  "scripts": {
    "release": "semantic-release",
    "test:release": "node --test tests/release_test.cjs",
    "setup": "node setup.js",
    "start": "node bridge/supervisor.js",
    "slots": "node bridge/install-slots.js",
    "test": "node tests/order_check.js && node --test tests/bridge_test.js tests/agents_test.js tests/restore_test.js tests/setup_test.js tests/addon_test.js tests/map_test.js tests/map_addon_test.js tests/macro_test.js && node tests/codec_test.js",
    "test:live": "node tests/inject_test.js",
    "probe": "python3 bridge/capture_x11.py --probe bridge/probe.png",
    "probe:mac": "python3 bridge/capture_mac.py --probe bridge/probe.png"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "fengari": "^0.1.4",
    "luaparse": "^0.3.1",
    "semantic-release": "^25.0.9"
  }
}
